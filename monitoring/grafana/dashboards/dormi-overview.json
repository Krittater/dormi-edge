              {
                "color": "orange",
                "value": 14
              },
              {
                "color": "green",
                "value": 30
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "ยังไม่มีข้อมูล",
          "decimals": 0
        },
        "overrides": []
