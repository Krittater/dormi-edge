    {
      "id": 9,
      "type": "table",
      "title": "งานเบื้องหลังทุกตัว",
      "description": "แต่ละแถวคือ 1 งานของระบบ (ออกบิล, ตรวจสลิป ฯลฯ) · 'สำเร็จล่าสุด' ควรอยู่ในรอบปกติของงาน (ออกบิลรายวัน < 26 ชม., งานทุกนาที < 10 นาที = 0.2 ชม.) · 'ล้มใน 7 วัน' ควรเป็น 0 · งาน boot.* รันเฉพาะตอนระบบเริ่มทำงาน จึงเก่าได้เป็นปกติ",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "h": 10,
        "w": 16,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "(time() - max by (job) (dormi_job_last_success_timestamp_seconds)) / 3600",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "round(sum by (job) (increase(dormi_job_runs_total{status=\"failed\"}[7d]))) or (max by (job) (dormi_job_last_run_timestamp_seconds) * 0)",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "(time() - max by (job) (dormi_job_last_run_timestamp_seconds)) / 3600",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "ยังไม่มีข้อมูลงาน",
          "decimals": 1,
          "custom": {
            "align": "auto",
