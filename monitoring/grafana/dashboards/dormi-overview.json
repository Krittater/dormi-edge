    {
      "id": 10,
      "type": "stat",
      "title": "backup ฐานข้อมูลล่าสุดเมื่อ",
      "description": "เวลาที่ backup รอบล่าสุดจบสำเร็จ (อ่านจากบรรทัด DONE ใน log backup) · ควรไม่เกิน 1 วัน · ถ้าไม่มีข้อมูลแปลว่าไม่พบ DONE ใน 3 วัน",
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "expr": "max_over_time({job=\"db-backup\"} |= \" DONE \" | regexp ` DONE (?P<ts>[0-9]+)` | unwrap ts [3d]) * 1000",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeFromNow",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "ไม่พบ backup"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
