    {
      "id": 2,
      "type": "stat",
      "title": "เว็บ/API ปกติไหม (ตรวจจากภายนอกทุก 2 นาที)",
      "description": "เขียว = ตอบปกติ, แดง = ล่ม · ข้อมูลมาจาก Grafana Synthetic Monitoring (4 จุด: เว็บ, API, admin API, หน้าแรก) · ถ้าขึ้น 'ยังไม่มีข้อมูล' แปลว่ายังไม่ได้สร้าง check ตาม synthetic-checks.md",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "max by (instance) (max_over_time(probe_success{instance=~`https://(app\\.|dormi-api\\.|admin-api\\.)?dormi-linkandrent\\.com/.*`}[5m]))",
          "instant": true,
          "range": false,
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "ล่ม",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "ปกติ",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "noValue": "ยังไม่มีข้อมูล"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "request ที่ error (5xx)",
      "description": "สัดส่วน request ที่เซิร์ฟเวอร์ตอบ error ใน 5 นาทีล่าสุด · เขียว < 1%, ส้ม 1–2%, แดง ≥ 2% (alert 'error พุ่ง' ดังที่ 2%)",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "(sum(rate(dormi_http_requests_total{status=~\"5..\"}[5m])) or vector(0)) / sum(rate(dormi_http_requests_total[5m]))",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.02
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "ไม่มี request",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto",
        "orientation": "auto"
      }
    },
    {
