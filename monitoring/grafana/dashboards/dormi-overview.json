      "type": "stat",
      "title": "เวลาตอบ (p95)",
      "description": "95% ของ request ตอบเร็วกว่าค่านี้ (ช่วง 5 นาทีล่าสุด) · ยิ่งน้อยยิ่งดี · เขียว < 0.5 วินาที, แดง ≥ 1.5 วินาที",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(dormi_http_request_duration_seconds_bucket[5m]))) * 1000",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
