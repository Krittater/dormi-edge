    {
      "id": 5,
      "type": "stat",
      "title": "cert (https) เหลือกี่วัน",
      "description": "จำนวนวันที่เหลือของใบรับรองที่ใกล้หมดสุดใน 4 เว็บ · แดง < 14 วัน (alert 'cert ใกล้หมด'), ส้ม < 30 วัน · certbot ต่ออายุอัตโนมัติ — ถ้าเหลือน้อยแปลว่าการต่ออายุมีปัญหา",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "min(((probe_ssl_earliest_cert_expiry{instance=~`https://(app\\.|dormi-api\\.|admin-api\\.)?dormi-linkandrent\\.com/.*`} > 0) - time()) / 86400)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: วัน",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
