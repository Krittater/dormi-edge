# คัดลอกเป็น .env ข้างไฟล์นี้บน server แล้วเติมค่า (chmod 600 — monitoring.sh ตั้งให้)
# ห้าม commit .env (อยู่ใน .gitignore แล้ว) · ห้ามใส่ค่าจริงในไฟล์นี้
#
# Grafana Cloud → Connections → Hosted Prometheus metrics / Hosted logs (H2 ในแผน)
#   URL ลงท้าย /api/prom/push และ /loki/api/v1/push · USER = เลข instance ID (ไม่ลับ)
GRAFANA_PROM_URL=
GRAFANA_PROM_USER=
GRAFANA_LOKI_URL=
GRAFANA_LOKI_USER=
# Access Policy token สิทธิ์ metrics:write + logs:write (ลับ)
GRAFANA_CLOUD_TOKEN=
# pg_stat_statements (query ช้า top 20 ใน dashboard, ไม่ส่งข้อความ SQL) — opt-in: on | off (ไม่ตั้ง = off)
# ตั้ง on เฉพาะเมื่อ DB พร้อมแล้ว: shared_preload_libraries มี pg_stat_statements + CREATE EXTENSION
# (ไม่พร้อมแล้วเปิด = alloy log error ทุกนาที) · `monitoring.sh inspect` บอกว่าพร้อมหรือยัง · แก้แล้วรัน `monitoring.sh up`
PG_STAT_STATEMENTS=off
# monitoring.sh setup สร้างให้เอง (role dormi_monitor + รหัสสุ่ม) — ไม่ต้องกรอกมือ
PG_MONITOR_DSN=
