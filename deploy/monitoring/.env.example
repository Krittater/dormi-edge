# คัดลอกเป็น .env ข้างไฟล์นี้บน server แล้วเติมค่า (chmod 600 — monitoring.sh ตั้งให้)
# ห้าม commit .env (อยู่ใน .gitignore แล้ว) · ห้ามใส่ค่าจริงในไฟล์นี้
#
# Grafana Cloud → Connections → Hosted Prometheus metrics / Hosted logs (H2 ในแผน)
#   URL ลงท้าย /api/prom/push และ /loki/api/v1/push · USER = เลข instance ID (ไม่ลับ)
GRAFANA_PROM_URL=
GRAFANA_PROM_USER=
GRAFANA_LOKI_URL=
GRAFANA_LOKI_USER=
# Access Policy token สิทธิ์ metrics:write + logs:write (ลับ)
GRAFANA_CLOUD_TOKEN=
# monitoring.sh setup สร้างให้เอง (role dormi_monitor + รหัสสุ่ม) — ไม่ต้องกรอกมือ
PG_MONITOR_DSN=
