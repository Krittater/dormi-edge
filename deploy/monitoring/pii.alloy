// ============================================================
// pii.alloy — ตัดข้อมูลส่วนบุคคล (PII) ออกจาก log ก่อนส่งออกนอกเครื่อง
// ------------------------------------------------------------
// ใช้ร่วมกัน 2 ที่ (ห้ามก๊อปไปเขียนซ้ำ — แก้ที่นี่ที่เดียว):
//   • config.alloy            ของจริงบน server (log ทุก container + log backup)
//   • test/redact-check.alloy ตรวจด้วย loki.echo ก่อน deploy (test/run-redact-check.sh)
//
// ลำดับจริง:
//   0. ลบรหัสสี ANSI (Nest logger ใส่สีเสมอแม้ไม่มี TTY: `\x1b[32m...\x1b[39m`) — ให้ regex ข้างล่างเจอข้อความจริง
//   1. log แอป `... [HttpRequest] {json}` → ดึง JSON หลัง `[HttpRequest] ` แล้วแยก `t`, `feature`, `status`
//      ทำ label เฉพาะ `feature` และ `status` และค่าต้องผ่าน regex เข้มก่อน (กัน label ระเบิด / PII ใน label)
//      ไม่ทำ label จาก route / user / apartmentId — ค้นจากเนื้อ log ตอน query แทน
//   1b. label `level` (error|warn|info) เฉพาะ service dormi-api / dormi-scheduler / dormi-admin: บรรทัด HTTP ตาม status
//      (5xx=error, 4xx=warn, อื่น=info) · บรรทัด Nest อื่นตาม ERROR|FATAL=error, WARN=warn, ที่เหลือ=info (ค่าคงที่ ไม่แตะเนื้อบรรทัด)
//   2. ตัด query string ใน "uri" และ "referer" ของ nginx access log (JSON) และใน error log ของ nginx
//      (ข้อความอิสระ: request: "GET /x?.. HTTP/1.1", upstream: "http://..?..", referrer: "..?..")
//   2b. log ของ container Postgres: `Failing row contains (...)` → [row] · `Key (cols)=(values)` → `Key (cols)=[key]`
//      (DETAIL ของ constraint error มีค่าทุกคอลัมน์ เช่น ชื่อ / ยอดเงิน) · `STATEMENT:  <sql>` → [statement]
//      · บรรทัดต่อที่ขึ้นต้นด้วย tab → [continued] · `CONTEXT:`/`QUERY:` → [context]/[query]
//      · ค่าในเครื่องหมายคำพูดหลัง ": " หรือ `Token "…"` → "[value]" (เช่น `invalid input syntax for type uuid: "…"`)
//      · ★ log_statement: `LOG:  statement|execute|bind|parse|duration …` และ `DETAIL:  parameters: …` → ทิ้งทั้งบรรทัด
//      (stage นี้จำกัดเฉพาะ container ชื่อมี postgres — test มี negative case ว่า container อื่นไม่โดน)
//   3. อีเมล (รวมแบบ URL-encoded %40)                   → [email]
//   3b. ข้อความอิสระใน path ของ URL (nginx JSON uri/referer · error log request:/upstream:/referrer:)
//      percent-encoded ติดกัน → [enc] · ตัวอักษรที่ไม่ใช่ ASCII → [text] · ASCII id/สแลชคงไว้
//   3c. บรรทัด error log ของ nginx ทั้งบรรทัด (เช่น open() "/var/www/certbot/…/<path>" failed): xHH/%XX → [enc], ไม่ใช่ ASCII → [text]
//      (stage.match ที่รูปแบบบรรทัด — container อื่นเช่น Nest ไม่โดน)
//   4. เลข 13 หลัก (บัตรประชาชน มี/ไม่มีขีด)             → [national-id]  (ก่อนเบอร์ — กันเบอร์กินบางส่วนของเลขบัตร)
//   5. เบอร์ไทย มือถือ 06/08/09 + บ้าน 02–07 (0x / +66 / 66) → [phone]
//   6. IPv4 ทุกตัวในบรรทัด (รวม client: ของ nginx)        → octet สุดท้ายเป็น 0
//   7. IPv6 ใน remote_addr / x_forwarded_for / client:   → เก็บ 3 กลุ่มแรก (/48) แล้วต่อ ::
//
// เลข 13 หลักที่ไม่ใช่บัตร (เช่น unix ms) และเลข 4 ส่วนแบบ IP ก็ถูกปิดด้วย — ตั้งใจ: ปิดเกินดีกว่าหลุด
// regex เป็น RE2 (Go) · ใช้ raw string `...` จึงไม่ต้อง escape backslash ซ้ำ
// ============================================================
declare "redact" {
	argument "forward_to" {
		comment  = "ปลายทางของ log ที่ตัด PII แล้ว (list(LogsReceiver))"
		optional = false
	}

	loki.process "pii" {
		forward_to = argument.forward_to.value

		// ── 0. รหัสสี ANSI ──
		stage.replace {
			expression = `(\x1b\[[0-9;]*[A-Za-z])`
			replace    = ""
		}

		// ── 1. label จาก log แอป ──
		stage.regex {
			expression = `\[HttpRequest\] (?P<http_payload>\{.*\})\s*$`
		}

		stage.json {
			source      = "http_payload"
			expressions = {
				t       = "",
				feature = "",
				status  = "",
			}
		}

		stage.regex {
			source     = "feature"
			expression = `^(?P<feature_label>[a-zA-Z0-9_.-]{1,40})$`
		}

		stage.regex {
			source     = "status"
			expression = `^(?P<status_label>[1-5][0-9][0-9])$`
		}

		stage.labels {
			values = {
				feature = "feature_label",
				status  = "status_label",
			}
		}

		// ── 1b. label `level` (error / warn / info) เฉพาะ log ของแอป dormi-api · dormi-scheduler · dormi-admin ──
		// ทำหลัง stage 0 (ตัด ANSI แล้ว ข้อความขึ้นต้น `[Nest] …` ตรง ๆ) และหลัง stage 1 (label status มาจากที่นั่น)
		// ค่า level เป็นค่าคงที่ 3 ค่า (ไม่ดึงข้อความจาก log) → ไม่มี PII ใน label และไม่แตะเนื้อบรรทัด จึงไม่กระทบ stage ปิดข้อมูลข้างล่าง
		// ลำดับ: ตั้ง info ก่อน → ทับด้วย Nest WARN/ERROR/FATAL → ท้ายสุดบรรทัด HTTP (`"t":"http"`) ให้ status ตัดสิน:
		//   5xx = error · 4xx = warn (ผู้ใช้กรอกผิด/ไม่มีสิทธิ์ ไม่ใช่ระบบพัง) · อื่น ๆ = info
		// คำว่า ERROR/WARN ต้องอยู่ตำแหน่ง level ของ Nest (`[Nest] <pid> - <วันที่> <เวลา> [AM|PM] <LEVEL> `) ไม่ใช่คำในข้อความ
		// บรรทัดต่อของ stack trace ไม่มี level → info (ค้นต่อด้วย container + เวลา) · container อื่น (web, nginx, postgres ฯลฯ) ไม่ได้ label level
		stage.match {
			selector = `{service=~"dormi-api|dormi-scheduler|dormi-admin"}`

			stage.static_labels {
				values = {
					level = "info",
				}
			}

			stage.match {
				selector = `{service=~".+"} |~ "^[[]Nest[]] +[0-9]+ +- +[^ ]+ +[^ ]+ +(?:[AP]M +)?WARN[ ]"`

				stage.static_labels {
					values = {
						level = "warn",
					}
				}
			}

			stage.match {
				selector = `{service=~".+"} |~ "^[[]Nest[]] +[0-9]+ +- +[^ ]+ +[^ ]+ +(?:[AP]M +)?(?:ERROR|FATAL)[ ]"`

				stage.static_labels {
					values = {
						level = "error",
					}
				}
			}

			stage.match {
				selector = `{status=~"[123].."} |= "\"t\":\"http\""`

				stage.static_labels {
					values = {
						level = "info",
					}
				}
			}

			stage.match {
				selector = `{status=~"4.."} |= "\"t\":\"http\""`

				stage.static_labels {
					values = {
						level = "warn",
					}
				}
			}

			stage.match {
				selector = `{status=~"5.."} |= "\"t\":\"http\""`

				stage.static_labels {
					values = {
						level = "error",
					}
				}
			}
		}

		// ── 2. query string ของ nginx (escape=json → ค่าอาจมี \" อยู่ข้างใน) ──
		stage.replace {
			expression = `"uri":"(?:[^"\\?]|\\.)*(\?(?:[^"\\]|\\.)*)"`
			replace    = ""
		}

		stage.replace {
			expression = `"referer":"(?:[^"\\?]|\\.)*(\?(?:[^"\\]|\\.)*)"`
			replace    = ""
		}

		// nginx error_log (stderr ของ container เดียวกัน) เป็นข้อความอิสระ ไม่ใช่ JSON
		stage.replace {
			expression = `request: "\S+ [^ ?"]*(\?[^ "]*)`
			replace    = ""
		}

		stage.replace {
			expression = `upstream: "[^"?]*(\?[^"]*)"`
			replace    = ""
		}

		stage.replace {
			expression = `referrer: "[^"?]*(\?[^"]*)"`
			replace    = ""
		}

		// ── 2b. Postgres: DETAIL ของ constraint error มีค่าจริงทั้งแถว ──
		stage.match {
			selector = `{container=~".*postgres.*"}`

			// log_statement=mod (prod ตั้งไว้) → ทุก INSERT/UPDATE/DELETE ลง log พร้อมค่าจริง:
			//   LOG:  statement: …  ·  LOG:  execute <ชื่อ>: …  ·  LOG:  bind|parse <ชื่อ>: …
			//   LOG:  duration: <x> ms  statement|execute|bind|parse …  ·  DETAIL:  parameters: $1 = '…'
			// ทิ้งทั้งบรรทัด (ไม่ mask): บรรทัดที่ปิดค่าแล้วเหลือแค่ "มี SQL รัน" ไม่มีประโยชน์ต่อ dashboard/alert
			// (อัตรา transaction ได้จาก postgres exporter อยู่แล้ว) และการทิ้งไม่พึ่ง regex ปิดค่าให้ครบทุกรูปแบบ
			// ดูสด ๆ บน server: docker logs dormi_postgres · ERROR:/FATAL:/WARNING: ไม่ถูกแตะ (ยังวิเคราะห์ error ได้)
			// สมมติฐาน: Postgres ใช้ข้อความอังกฤษ (lc_messages ค่าเริ่มต้นของ image) — เปลี่ยน locale แล้วคำว่า LOG:/DETAIL:/statement จะไม่ตรง กฎนี้ไม่ทำงาน
			// log_error_verbosity=verbose (พิมพ์ SQLSTATE `LOG:  00000: statement:`) รองรับแล้วด้วยส่วน optional `[0-9A-Z]{5}: `
			stage.drop {
				expression          = `(?:LOG:  (?:[0-9A-Z]{5}: )?(?:statement: |(?:execute|bind|parse) |duration: )|DETAIL:  (?:[0-9A-Z]{5}: )?parameters: )`
				drop_counter_reason = "pg_log_statement"
			}

			stage.replace {
				expression = `Failing row contains (\(.*\))`
				replace    = "[row]"
			}

			stage.replace {
				expression = `Key \(.*?\)(=\(.*\))`
				replace    = "=[key]"
			}

			// error ทุกตัว Postgres log `STATEMENT:` = SQL เต็ม (มีค่าจริงถ้าไม่ได้ใช้ $1) และบรรทัดต่อ
			// ของข้อความหลายบรรทัดขึ้นต้นด้วย tab (docker แยกเป็นคนละ entry) → ปิดทั้งคู่
			stage.replace {
				expression = `STATEMENT:  (.+)`
				replace    = "[statement]"
			}

			stage.replace {
				expression = `^\t(.+)$`
				replace    = "[continued]"
			}

			// CONTEXT: / QUERY: สะท้อนค่าหรือ SQL ที่ผู้ใช้ส่งมา → ปิดทั้งก้อน
			stage.replace {
				expression = `CONTEXT:  (.+)`
				replace    = "[context]"
			}

			stage.replace {
				expression = `QUERY:  (.+)`
				replace    = "[query]"
			}

			// ค่าที่ผู้ใช้พิมพ์ในข้อความ error: `... type uuid: "<ค่า>"`, `... enum x: "<ค่า>"`, `Token "<ค่า>"`
			// เก็บข้อความชนิด error ไว้ (ยังวิเคราะห์ได้) · ชื่อ relation/constraint ที่ไม่ได้ตามหลัง ": " ไม่โดน
			stage.replace {
				expression = `Token "(.*)"`
				replace    = "[value]"
			}

			stage.replace {
				expression = `: "(.*)"`
				replace    = "[value]"
			}
		}

		// ── 3. อีเมล ──
		stage.replace {
			expression = `([A-Za-z0-9._%+-]+(?:@|%40)[A-Za-z0-9-]+(?:\.[A-Za-z0-9-]+)*\.[A-Za-z]{2,})`
			replace    = "[email]"
		}

		// ── 3b. ข้อความอิสระใน "path" ของ URL (ชื่อไทย ฯลฯ ที่ผู้ใช้/สแกนเนอร์พิมพ์เอง) ──
		// route จริงของ Dormi มีแต่ id/code ใน path → ปิดทุกอย่างที่ไม่ใช่ ASCII ธรรมดา:
		//   • ชุด percent-encoded ติดกัน (%E0%B8%A0…)  → [enc]
		//   • ตัวอักษรที่ไม่ใช่ ASCII ดิบ (ไทย ฯลฯ)       → [text]
		// ASCII id/uuid/สแลชคงไว้ · ทำหลัง stage อีเมล (3) เพื่อให้ `a%40b.com` ได้ [email] ก่อน
		// ใช้ template (regexReplaceAllLiteral บนค่าที่จับได้) เพราะ regex ตัวเดียวแทนหลายชุดในค่าเดียวไม่ได้
		// ช่องที่ครอบ: nginx JSON "uri"/"referer" · error log request:/upstream:/referrer:
		// (error log ของ nginx พิมพ์ไบต์ที่ไม่ใช่ ASCII เป็น \xHH จึงรับรูปนั้นด้วย)
		stage.replace {
			expression = `"uri":"((?:[^"\\]|\\.)*)"`
			replace    = `{{ regexReplaceAllLiteral "[^\\x00-\\x7F]+" (regexReplaceAllLiteral "(?:%[0-9A-Fa-f]{2})+" .Value "[enc]") "[text]" }}`
		}

		stage.replace {
			expression = `"referer":"((?:[^"\\]|\\.)*)"`
			replace    = `{{ regexReplaceAllLiteral "[^\\x00-\\x7F]+" (regexReplaceAllLiteral "(?:%[0-9A-Fa-f]{2})+" .Value "[enc]") "[text]" }}`
		}

		stage.replace {
			expression = `request: "\S+ ([^"]*?)(?: HTTP/[0-9.]+)?"`
			replace    = `{{ regexReplaceAllLiteral "[^\\x00-\\x7F]+" (regexReplaceAllLiteral "(?:%[0-9A-Fa-f]{2}|\\\\x[0-9A-Fa-f]{2})+" .Value "[enc]") "[text]" }}`
		}

		stage.replace {
			expression = `upstream: "([^"]*)"`
			replace    = `{{ regexReplaceAllLiteral "[^\\x00-\\x7F]+" (regexReplaceAllLiteral "(?:%[0-9A-Fa-f]{2}|\\\\x[0-9A-Fa-f]{2})+" .Value "[enc]") "[text]" }}`
		}

		stage.replace {
			expression = `referrer: "([^"]*)"`
			replace    = `{{ regexReplaceAllLiteral "[^\\x00-\\x7F]+" (regexReplaceAllLiteral "(?:%[0-9A-Fa-f]{2}|\\\\x[0-9A-Fa-f]{2})+" .Value "[enc]") "[text]" }}`
		}

		// ── 3c. nginx error log ทั้งบรรทัด ──
		// ข้อความ error อื่นฝัง path ที่ถอดรหัสแล้วด้วย เช่น `open() "/var/www/certbot/.well-known/acme-challenge/<ไทย>" failed`
		// (location ACME บนพอร์ต 80 รับ path อะไรก็ได้) ซึ่งกฎ request:/upstream:/referrer: ไม่เห็น
		// → เฉพาะบรรทัดที่หน้าตาเป็น error log ของ nginx (`2026/10/24 09:00:00 [`) ปิดทั้งบรรทัด:
		//   \xHH / %XX ติดกัน → [enc] · ตัวอักษรที่ไม่ใช่ ASCII → [text] (อีเมล `@` ถูก stage 3 เป็น [email] ไปแล้ว)
		// ห้ามใช้กับ container อื่น: log Nest มีภาษาไทยปกติ (selector ล็อกที่รูปแบบบรรทัด ไม่ใช่ชื่อ container
		// เพราะ test ไม่มี label container)
		stage.match {
			selector = `{job=~".*"} |~ "^[0-9]{4}/[0-9]{2}/[0-9]{2} [0-9:]{8} [[]"`

			stage.replace {
				expression = `((?:%[0-9A-Fa-f]{2}|\\x[0-9A-Fa-f]{2})+)`
				replace    = "[enc]"
			}

			stage.replace {
				expression = `([^\x00-\x7F]+)`
				replace    = "[text]"
			}
		}

		// ── 4. เลขบัตรประชาชน 13 หลัก ──
		stage.replace {
			expression = `\b([1-8][ -]?\d{4}[ -]?\d{5}[ -]?\d{2}[ -]?\d)\b`
			replace    = "[national-id]"
		}

		// ── 5. เบอร์ไทย: 0812345678, 081-234-5678, +66 81 234 5678, 02-123-4567, 66812345678 ──
		stage.replace {
			expression = `((?:\+66[ -]?|\b66|\b0)(?:[689]\d|[2-7])[ -]?\d{3}[ -]?\d{4})\b`
			replace    = "[phone]"
		}

		// ── 6. IPv4 → octet สุดท้ายเป็น 0 ──
		stage.replace {
			expression = `\b(?:\d{1,3}\.){3}(\d{1,3})\b`
			replace    = "0"
		}

		// ── 7. IPv6 ใน remote_addr / x_forwarded_for / client: → เก็บ /48 ──
		stage.replace {
			expression = `(?:"(?:remote_addr|x_forwarded_for)":"|, |client: )[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{0,4}:[0-9A-Fa-f]{0,4}(:[0-9A-Fa-f:.]*)`
			replace    = "::"
		}
	}

	export "receiver" {
		value = loki.process.pii.receiver
	}
}
