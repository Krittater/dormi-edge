// ============================================================
// pii.alloy — ตัดข้อมูลส่วนบุคคล (PII) ออกจาก log ก่อนส่งออกนอกเครื่อง
// ------------------------------------------------------------
// ใช้ร่วมกัน 2 ที่ (ห้ามก๊อปไปเขียนซ้ำ — แก้ที่นี่ที่เดียว):
//   • config.alloy            ของจริงบน server (log ทุก container + log backup)
//   • test/redact-check.alloy ตรวจด้วย loki.echo ก่อน deploy (test/run-redact-check.sh)
//
// ลำดับจริง:
//   0. ลบรหัสสี ANSI (Nest logger ใส่สีเสมอแม้ไม่มี TTY: `\x1b[32m...\x1b[39m`) — ให้ regex ข้างล่างเจอข้อความจริง
//   1. log แอป `... [HttpRequest] {json}` → ดึง JSON หลัง `[HttpRequest] ` แล้วแยก `t`, `feature`, `status`
//      ทำ label เฉพาะ `feature` และ `status` และค่าต้องผ่าน regex เข้มก่อน (กัน label ระเบิด / PII ใน label)
//      ไม่ทำ label จาก route / user / apartmentId — ค้นจากเนื้อ log ตอน query แทน
//   2. ตัด query string ใน "uri" และ "referer" ของ nginx access log (JSON) และใน error log ของ nginx
//      (ข้อความอิสระ: request: "GET /x?.. HTTP/1.1", upstream: "http://..?..", referrer: "..?..")
//   2b. log ของ container Postgres: `Failing row contains (...)` → [row] · `Key (cols)=(values)` → `Key (cols)=[key]`
//      (DETAIL ของ constraint error มีค่าทุกคอลัมน์ เช่น ชื่อ / ยอดเงิน) · `STATEMENT:  <sql>` → [statement]
//      · บรรทัดต่อที่ขึ้นต้นด้วย tab → [continued] · `CONTEXT:`/`QUERY:` → [context]/[query]
//      · ค่าในเครื่องหมายคำพูดหลัง ": " หรือ `Token "…"` → "[value]" (เช่น `invalid input syntax for type uuid: "…"`)
//      (stage นี้จำกัดเฉพาะ container ชื่อมี postgres — test มี negative case ว่า container อื่นไม่โดน)
//   3. อีเมล (รวมแบบ URL-encoded %40)                   → [email]
//   4. เลข 13 หลัก (บัตรประชาชน มี/ไม่มีขีด)             → [national-id]  (ก่อนเบอร์ — กันเบอร์กินบางส่วนของเลขบัตร)
//   5. เบอร์ไทย มือถือ 06/08/09 + บ้าน 02–07 (0x / +66 / 66) → [phone]
//   6. IPv4 ทุกตัวในบรรทัด (รวม client: ของ nginx)        → octet สุดท้ายเป็น 0
//   7. IPv6 ใน remote_addr / x_forwarded_for / client:   → เก็บ 3 กลุ่มแรก (/48) แล้วต่อ ::
//
// เลข 13 หลักที่ไม่ใช่บัตร (เช่น unix ms) และเลข 4 ส่วนแบบ IP ก็ถูกปิดด้วย — ตั้งใจ: ปิดเกินดีกว่าหลุด
// regex เป็น RE2 (Go) · ใช้ raw string `...` จึงไม่ต้อง escape backslash ซ้ำ
// ============================================================
declare "redact" {
	argument "forward_to" {
		comment  = "ปลายทางของ log ที่ตัด PII แล้ว (list(LogsReceiver))"
		optional = false
	}

	loki.process "pii" {
		forward_to = argument.forward_to.value

		// ── 0. รหัสสี ANSI ──
		stage.replace {
			expression = `(\x1b\[[0-9;]*[A-Za-z])`
			replace    = ""
		}

		// ── 1. label จาก log แอป ──
		stage.regex {
			expression = `\[HttpRequest\] (?P<http_payload>\{.*\})\s*$`
		}

		stage.json {
			source      = "http_payload"
			expressions = {
				t       = "",
				feature = "",
				status  = "",
			}
		}

		stage.regex {
			source     = "feature"
			expression = `^(?P<feature_label>[a-zA-Z0-9_.-]{1,40})$`
		}

		stage.regex {
			source     = "status"
			expression = `^(?P<status_label>[1-5][0-9][0-9])$`
		}

		stage.labels {
			values = {
				feature = "feature_label",
				status  = "status_label",
			}
		}

		// ── 2. query string ของ nginx (escape=json → ค่าอาจมี \" อยู่ข้างใน) ──
		stage.replace {
			expression = `"uri":"(?:[^"\\?]|\\.)*(\?(?:[^"\\]|\\.)*)"`
			replace    = ""
		}

		stage.replace {
			expression = `"referer":"(?:[^"\\?]|\\.)*(\?(?:[^"\\]|\\.)*)"`
			replace    = ""
		}

		// nginx error_log (stderr ของ container เดียวกัน) เป็นข้อความอิสระ ไม่ใช่ JSON
		stage.replace {
			expression = `request: "\S+ [^ ?"]*(\?[^ "]*)`
			replace    = ""
		}

		stage.replace {
			expression = `upstream: "[^"?]*(\?[^"]*)"`
			replace    = ""
		}

		stage.replace {
			expression = `referrer: "[^"?]*(\?[^"]*)"`
			replace    = ""
		}

		// ── 2b. Postgres: DETAIL ของ constraint error มีค่าจริงทั้งแถว ──
		stage.match {
			selector = `{container=~".*postgres.*"}`

			stage.replace {
				expression = `Failing row contains (\(.*\))`
				replace    = "[row]"
			}

			stage.replace {
				expression = `Key \(.*?\)(=\(.*\))`
				replace    = "=[key]"
			}

			// error ทุกตัว Postgres log `STATEMENT:` = SQL เต็ม (มีค่าจริงถ้าไม่ได้ใช้ $1) และบรรทัดต่อ
			// ของข้อความหลายบรรทัดขึ้นต้นด้วย tab (docker แยกเป็นคนละ entry) → ปิดทั้งคู่
			stage.replace {
				expression = `STATEMENT:  (.+)`
				replace    = "[statement]"
			}

			stage.replace {
				expression = `^\t(.+)$`
				replace    = "[continued]"
			}

			// CONTEXT: / QUERY: สะท้อนค่าหรือ SQL ที่ผู้ใช้ส่งมา → ปิดทั้งก้อน
			stage.replace {
				expression = `CONTEXT:  (.+)`
				replace    = "[context]"
			}

			stage.replace {
				expression = `QUERY:  (.+)`
				replace    = "[query]"
			}

			// ค่าที่ผู้ใช้พิมพ์ในข้อความ error: `... type uuid: "<ค่า>"`, `... enum x: "<ค่า>"`, `Token "<ค่า>"`
			// เก็บข้อความชนิด error ไว้ (ยังวิเคราะห์ได้) · ชื่อ relation/constraint ที่ไม่ได้ตามหลัง ": " ไม่โดน
			stage.replace {
				expression = `Token "(.*)"`
				replace    = "[value]"
			}

			stage.replace {
				expression = `: "(.*)"`
				replace    = "[value]"
			}
		}

		// ── 3. อีเมล ──
		stage.replace {
			expression = `([A-Za-z0-9._%+-]+(?:@|%40)[A-Za-z0-9-]+(?:\.[A-Za-z0-9-]+)*\.[A-Za-z]{2,})`
			replace    = "[email]"
		}

		// ── 4. เลขบัตรประชาชน 13 หลัก ──
		stage.replace {
			expression = `\b([1-8][ -]?\d{4}[ -]?\d{5}[ -]?\d{2}[ -]?\d)\b`
			replace    = "[national-id]"
		}

		// ── 5. เบอร์ไทย: 0812345678, 081-234-5678, +66 81 234 5678, 02-123-4567, 66812345678 ──
		stage.replace {
			expression = `((?:\+66[ -]?|\b66|\b0)(?:[689]\d|[2-7])[ -]?\d{3}[ -]?\d{4})\b`
			replace    = "[phone]"
		}

		// ── 6. IPv4 → octet สุดท้ายเป็น 0 ──
		stage.replace {
			expression = `\b(?:\d{1,3}\.){3}(\d{1,3})\b`
			replace    = "0"
		}

		// ── 7. IPv6 ใน remote_addr / x_forwarded_for / client: → เก็บ /48 ──
		stage.replace {
			expression = `(?:"(?:remote_addr|x_forwarded_for)":"|, |client: )[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{0,4}:[0-9A-Fa-f]{0,4}(:[0-9A-Fa-f:.]*)`
			replace    = "::"
		}
	}

	export "receiver" {
		value = loki.process.pii.receiver
	}
}
