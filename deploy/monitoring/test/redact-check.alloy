import.file "pii" {
	filename = file.path_join(module_path, "../pii.alloy")
}

local.file_match "sample" {
	path_targets = [
		{"__path__" = file.path_join(module_path, "sample.log"), "job" = "redact-check"},
		// จำลอง log ของ container Postgres (stage ที่ scope ด้วย label container)
		{"__path__" = file.path_join(module_path, "sample-postgres.log"), "job" = "redact-check", "container" = "dormi_postgres", "service" = "postgres"},
	]
}

loki.source.file "sample" {
	targets    = local.file_match.sample.targets
	forward_to = [pii.redact.out.receiver]
}

pii.redact "out" {
	forward_to = [loki.echo.out.receiver]
}

loki.echo "out" { }
